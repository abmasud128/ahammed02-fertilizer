# Ahammed Fertilizer - Environment Variables Configuration
# Copy this file to .env.local for development and configure production variables in Vercel / hosting platform.

# ==========================================
# 1. APPLICATION & AUTHENTICATION SECRETS
# ==========================================
# Required in production. Generate a unique random value of at least 32 characters.
ADMIN_SESSION_SECRET=

# Required in production. Use unique owner credentials; cashier credentials are optional.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
CASHIER_LOGIN_EMAIL=
CASHIER_LOGIN_PASSWORD=

# Optional separate farmer-session signing secret. If omitted, the admin secret is used.
FARMER_SESSION_SECRET=
